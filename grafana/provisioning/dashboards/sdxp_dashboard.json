          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    date_trunc('minute', alle_telegramme.\"timestamp\") \r\n    + INTERVAL '30 seconds' * FLOOR(EXTRACT(SECOND FROM alle_telegramme.\"timestamp\") / 30) AS \"time\",\r\n    typ AS steuerung,\r\n    COUNT(*) AS anzahl\r\nFROM (\r\n    SELECT 'SDXP'  AS typ, \"timestamp\" FROM sdxp_log\r\n    UNION ALL\r\n    SELECT 'TT14',          \"timestamp\" FROM tt14_log\r\n    UNION ALL\r\n    SELECT 'TT9001',        \"timestamp\" FROM tt9001_log\r\n) AS alle_telegramme\r\nGROUP BY \"time\", typ\r\nORDER BY \"time\";",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
