          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  date_trunc('minute', \"timestamp\") + INTERVAL '30 seconds' * FLOOR(\r\n    EXTRACT(\r\n      SECOND\r\n      FROM\r\n        \"timestamp\"\r\n    ) / 30\r\n  ) AS \"time\",\r\n  steuerung,\r\n  COUNT(*) AS count\r\nFROM\r\n  (\r\n    SELECT\r\n      \"timestamp\",\r\n      sender AS steuerung\r\n    FROM\r\n      sdxp_log\r\n    UNION\r\n    ALL\r\n    SELECT\r\n      \"timestamp\",\r\n      empfaenger AS steuerung\r\n    FROM\r\n      sdxp_log\r\n  ) AS alle\r\nWHERE\r\n  steuerung != 'MFS'\r\nGROUP BY\r\n  \"time\",\r\n  steuerung\r\nORDER BY\r\n  \"time\";",
